EARTHAI_DATA_DIR=./data
EARTHAI_ALLOW_REGISTRATION=true
EARTHAI_COOKIE_SECURE=false
EARTHAI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# EARTHAI_SQLITE_JOURNAL_MODE=DELETE
# EARTHAI_BACKUP_DIR=./data/backups
# NAS storage is attached by the deployment platform at /app/data; no host-path variable is needed.
# EARTHAI_MASTER_KEY may be set to the original Fernet key; otherwise data/master.key is created once.
